# Monetra private settings.
#
# First time only: copy this file to a new file named ".env" (same folder, nothing after ".env"),
# then fill in the values you have. Leave a value empty to keep that feature switched off.
#
# ".env" is ignored by Git. Never upload it, never paste it into a chat, never share it.
# This example file is safe to share: it holds no real values.
#
# Rules: one NAME=value per line, no spaces around "=", no quotes needed, no comment after a value.
# start-local.ps1 reads this file. A value you already set in the terminal is never overwritten.

# --- PayPal Sandbox: developer.paypal.com -> Apps & Credentials -> Sandbox -> your app ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The ID of the webhook you create in the PayPal dashboard (optional until you use webhooks)
PAYPAL_WEBHOOK_ID=

# --- Setu Account Aggregator sandbox (Check Balance): bridge.setu.co -> your product -> API credentials ---
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=

# --- AI (all optional; without them Monetra uses its rule-based advice) ---
# Groq, a free online AI: console.groq.com -> API Keys. When set, Monetra uses Groq instead of the laptop AI.
GROQ_API_KEY=
# Claude (paid): console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional: sign-up codes by email (a Gmail address and its App Password) ---
# Empty: the sign-up code is printed in the terminal instead.
MONETRA_MAIL_USERNAME=
MONETRA_MAIL_PASSWORD=

# --- Optional: password of the two local demo accounts ---
# Empty: the default written in the README (for this computer only). Set your own before going online.
MONETRA_DEMO_PASSWORD=
